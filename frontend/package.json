{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "copy-plotly": "node -e \"require('fs').copyFileSync(require.resolve('plotly.js-gl3d-dist-min/plotly-gl3d.min.js'),'public/vendor/plotly-gl3d.min.js')\"",
    "build:reference": "node scripts/generate-app-reference.mjs",
    "predev": "pnpm --filter @scatterlab/stats run build && pnpm run build:reference && node -e \"require('fs').mkdirSync('public/vendor',{recursive:true})\" && pnpm run copy-plotly",
    "prebuild": "pnpm --filter @scatterlab/stats run build && pnpm run build:reference && node -e \"require('fs').mkdirSync('public/vendor',{recursive:true})\" && pnpm run copy-plotly",
    "dev": "node scripts/dev.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "pretest": "pnpm run build:reference",
    "test": "vitest run",
    "ci:fast": "pnpm run build:reference && node scripts/ci/fast.mjs",
    "ci:contracts": "node --test scripts/efa-reference/formal/source-contract.check.mjs scripts/ci/contracts.check.mjs scripts/generate-app-reference.check.mjs scripts/ci/deployment.check.mjs",
    "ci:lint": "node scripts/ci/lint-regression.mjs",
    "ci:numerical": "node scripts/ci/numerical.mjs",
    "ci:reference-integrity": "node scripts/ci/reference-integrity.mjs",
    "ci:reference-r": "bash scripts/ci/fresh-r.sh",
    "ci:large": "node scripts/efa-reference/congruence/run-large.mjs"
  },
  "dependencies": {
    "@types/papaparse": "5.5.2",
    "gifenc": "1.0.3",
    "hyparquet": "1.32.0",
    "lucide-react": "1.70.0",
    "ml-matrix": "6.15.1",
    "next": "16.4.5",
    "next-themes": "0.4.6",
    "openai": "7.53.0",
    "papaparse": "5.7.0",
    "plotly.js-gl3d-dist-min": "4.2.0",
    "puxel": "0.1.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "remark-breaks": "4.0.0",
    "remark-gfm": "4.0.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "@scatterlab/stats": "workspace:*",
    "@scatterlab/react-plotly-factory": "workspace:*"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.5",
    "happy-dom": "21.0.4",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  },
  "engines": {
    "node": "24.x"
  },
  "packageManager": "pnpm@12.18.0"
}
